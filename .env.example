# --- IA (Claude) ---
# Chave da API da Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Busca de empresas (Google Places API "New") ---
# Ative "Places API (New)" no Google Cloud e gere uma chave.
GOOGLE_PLACES_API_KEY=

# --- Envio por e-mail (SMTP) ---
SMTP_HOST=smtp.seudominio.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contato@seudominio.com.br
SMTP_PASS=
EMAIL_REMETENTE="Sua Empresa <contato@seudominio.com.br>"
# Endereço que recebe pedidos de descadastro via List-Unsubscribe (mailto)
EMAIL_DESCADASTRO=descadastro@seudominio.com.br

# --- Leitura das respostas (IMAP da mesma caixa que envia) ---
# Se vazio, usa SMTP_USER/SMTP_PASS. Gmail: imap.gmail.com com senha de app.
IMAP_HOST=imap.seudominio.com.br
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_PASTA=INBOX
# Frequência da verificação de respostas (cron). Vazio = desligado.
VERIFICAR_RESPOSTAS_CRON=*/10 * * * *
# Recebe um aviso por e-mail quando alguém responde com interesse
NOTIFICAR_EMAIL=voce@seudominio.com.br

# --- Modo teste ---
# Preenchido = TODAS as mensagens vão para estes contatos (seu e-mail/celular),
# nada chega às empresas. Use para calibrar as propostas antes de ligar de verdade.
MODO_TESTE_EMAIL=
MODO_TESTE_WHATSAPP=

# --- Envio por WhatsApp (API oficial Cloud API da Meta) ---
# Desativado por padrão. A Meta exige template aprovado e consentimento (opt-in)
# para mensagens iniciadas pela empresa. Leia o README antes de ativar.
WHATSAPP_ATIVO=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=proposta_inicial
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
WHATSAPP_API_VERSION=v21.0
# Webhook para receber respostas: configure no app da Meta a URL
# <URL_PUBLICA>/webhooks/whatsapp com este token de verificação.
WHATSAPP_VERIFY_TOKEN=
# "App secret" do app da Meta, usado para validar a assinatura do webhook
WHATSAPP_APP_SECRET=

# --- Painel ---
PORTA=3000
# URL pública do painel (usada no link de descadastro dos e-mails)
URL_PUBLICA=http://localhost:3000
PAINEL_USUARIO=admin
PAINEL_SENHA=troque-esta-senha

# Agendamento automático do ciclo completo (formato cron). Vazio = desligado.
# Exemplo: de segunda a sexta às 9h30 -> 30 9 * * 1-5
CICLO_CRON=
TZ=America/Sao_Paulo

# Caminho do banco SQLite
DB_PATH=data/prospecta.db
