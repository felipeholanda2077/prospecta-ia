{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/descadastrar/(.*)",
      "destination": "/api"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "/api"
    },
    {
      "source": "/contato",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{config/**,node_modules/pdfkit/js/data/**,public/post-desenho.js,public/fluxdeck-logo.jpg,public/felipe-holanda.jpg,node_modules/ffmpeg-static/ffmpeg,node_modules/@fontsource/inter/files/inter-latin-*-normal.woff2,node_modules/@fontsource/inter/files/inter-latin-ext-*-normal.woff2}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/ciclo",
      "schedule": "30 12 * * 1-5"
    },
    {
      "path": "/api/cron/envios",
      "schedule": "0 16 * * 1-5"
    }
  ]
}
